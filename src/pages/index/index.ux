<template>
  <div class="container" style="background-color: #000000;">
    
    <!-- ГЛАВНОЕ МЕНЮ: ЭЛИТНЫЙ НАТИВНЫЙ СВАЙПЕР ГЕРОЕВ -->
    <div class="menu-view" if="{{viewMode === 'menu'}}">
      <text class="title">ВЫБОР ГЕРОЯ</text>
      
      <!-- Свайпер с авто-перекрашиванием и тактильным кликом -->
      <swiper class="hero-swiper" index="{{charIndex}}" duration="250" loop="false" onchange="onHeroSwipe">
        <div class="char-card" for="{{characters}}">
          <div class="neon-border" style="border-color: {{$item.color}};">
            <text class="char-name" style="color: {{$item.color}}">{{$item.name}}</text>
          </div>
          <text class="char-bio">{{$item.bio}}</text>
          <text class="char-skill" style="color: {{$item.color}}">Навык: {{$item.skill}}</text>
          
          <!-- Дорогая кастомная кнопка старта, стилизованная под цвет героя -->
          <div class="premium-start-btn" style="background-color: {{$item.color}};" onclick="startGame">
            <text class="start-btn-text">НАЧАТЬ ИГРУ</text>
          </div>
        </div>
      </swiper>

      <div class="premium-action-btn" onclick="showAchievements">
        <text class="action-btn-text">ГАЛЕРЕЯ ТРОФЕЕВ</text>
      </div>
    </div>

    <!-- ИГРОВОЙ ПРОЦЕСС (ЭКРАН АДАПТИВНО ОКРАШИВАЕТСЯ) -->
    <div class="game-view" if="{{viewMode === 'game'}}" style="border-color: {{activeChar.color}};">
      <text class="stage-title" style="color: {{activeChar.color}};">{{stageTitle}}</text>
      <text class="game-text">{{gameText}}</text>
      
      <div class="stats-row">
        <text class="stat-lbl" style="color: {{activeChar.color}};">😎 Уверенность: {{confidencePoints}}/100</text>
        <text class="stat-lbl" style="color: #ff5555;">Anxiety Level: {{anxietyPoints}}/100</text>
      </div>

      <div class="timer-box" if="{{isLocked}}">
        <text class="timer-text" style="color: {{activeChar.color}};">⏳ Синхронизация данных... {{timerSeconds}}с</text>
      </div>

      <div class="choices-box" if="{{!isLocked}}">
        <div class="premium-choice" style="border-color: {{activeChar.color}};" onclick="makeChoice(1)">
          <text class="choice-txt">{{choice1Text}}</text>
        </div>
        <div class="premium-choice" style="border-color: {{activeChar.color}};" onclick="makeChoice(2)">
          <text class="choice-txt">{{choice2Text}}</text>
        </div>
        <div class="premium-choice-alt" onclick="makeSarcasm" if="{{hasSarcasm}}">
          <text class="choice-txt-alt">💬 Использовать Сарказм</text>
        </div>
      </div>
    </div>

    <!-- ЭКРАН КОНЦОВОК -->
    <div class="ending-view" if="{{viewMode === 'ending'}}" style="border-color: {{activeChar.color}};">
      <text class="ending-title" style="color: {{activeChar.color}};">ФИНАЛ {{endingId}}</text>
      <text class="ending-text">{{endingText}}</text>
      <div class="premium-action-btn" style="background-color: {{activeChar.color}};" onclick="backToMenu">
        <text class="action-btn-text" style="color: #000000; font-weight: bold;">В МЕНЮ</text>
      </div>
    </div>

    <!-- ГАЛЕРЕЯ ДОСТИЖЕНИЙ -->
    <div class="achievements-view" if="{{viewMode === 'achievements'}}">
      <text class="title" style="color: #ffcc00;">СТАТУС ПРОФИЛЯ</text>
      <div class="ach-box {{ach1 ? 'unlocked' : 'locked'}}"><text class="ach-txt">💎 Аналитика Солдатова</text></div>
      <div class="ach-box {{ach2 ? 'unlocked' : 'locked'}}"><text class="ach-txt">🔥 Тотальный Солдаут</text></div>
      <div class="ach-box {{ach3 ? 'unlocked' : 'locked'}}"><text class="ach-txt">👑 Гранд-Мастер</text></div>
      <div class="premium-action-btn" onclick="backToMenu">
        <text class="action-btn-text">ВЕРНУТЬСЯ</text>
      </div>
    </div>

  </div>
</template>

<style>
  .container { width: 212px; height: 520px; flex-direction: column; align-items: center; justify-content: center; padding: 12px; font-family: monospace; }
  .menu-view, .game-view, .ending-view, .achievements-view { width: 200px; height: 100%; flex-direction: column; align-items: center; justify-content: center; }
  .game-view, .ending-view { border: 2px solid #333333; border-radius: 12px; padding: 8px; height: 490px; }
  .title, .stage-title, .ending-title { font-size: 18px; color: #ffffff; font-weight: bold; text-align: center; margin-bottom: 8px; letter-spacing: 1px; }
  
  .hero-swiper { width: 200px; height: 380px; background-color: #000000; }
  .char-card { flex-direction: column; align-items: center; justify-content: center; width: 200px; height: 380px; padding: 4px; }
  .neon-border { border: 1px solid #ffffff; padding: 6px 12px; border-radius: 8px; margin-bottom: 10px; }
  .char-name { font-size: 20px; font-weight: bold; text-align: center; }
  .char-bio { font-size: 13px; color: #aaaaaa; text-align: center; height: 120px; margin: 4px 6px; }
  .char-skill { font-size: 12px; font-weight: bold; margin-bottom: 15px; }
  
  .premium-start-btn { width: 160px; height: 40px; justify-content: center; align-items: center; border-radius: 20px; margin-top: 10px; }
  .start-btn-text { color: #000000; font-size: 14px; font-weight: bold; }
  .premium-action-btn { width: 170px; height: 38px; background-color: #1a111a; border: 1px solid #443344; justify-content: center; align-items: center; border-radius: 8px; margin-top: 10px; }
  .action-btn-text { color: #ffffff; font-size: 13px; }
  
  .game-text, .ending-text { font-size: 14px; color: #e0e0e0; text-align: center; margin-bottom: 8px; height: 180px; padding: 0 4px; }
  .stats-row { flex-direction: column; align-items: flex-start; width: 180px; margin-bottom: 12px; }
  .stat-lbl { font-size: 12px; font-weight: bold; margin-top: 2px; }
  
  .choices-box, .timer-box { flex-direction: column; width: 180px; align-items: center; }
  .timer-text { font-size: 13px; text-align: center; }
  
  .premium-choice { width: 180px; height: 42px; background-color: #080808; border: 1px solid #333333; justify-content: center; align-items: center; margin-bottom: 6px; border-radius: 8px; }
  .premium-choice-alt { width: 180px; height: 42px; background-color: #1f0a0a; border: 1px solid #4d1414; justify-content: center; align-items: center; border-radius: 8px; }
  .choice-txt { color: #ffffff; font-size: 12px; text-align: center; padding: 0 4px; }
  .choice-txt-alt { color: #ff5555; font-size: 12px; font-weight: bold; }
  
  .ach-box { width: 180px; height: 40px; justify-content: center; align-items: center; margin-bottom: 8px; border-radius: 6px; border: 1px solid #222222; }
  .unlocked { background-color: #051a05; border-color: #00ff88; }
  .locked { background-color: #111111; opacity: 0.4; }
  .ach-txt { color: #ffffff; font-size: 13px; }
</style>

<script>
  import router from '@system.router';
  import storage from '@system.storage';
  import vibrator from '@system.vibrator';
  import { DailyPlots } from './story_data.js';

  const characters = [
    { id: "cheshiya", name: "Чешия", bio: "Специалист по теории игр из Алисы в Пограничье. Оценивает риски.", skill: "Просчет вероятностей", color: "#ffffff" },
    { id: "rick_c137", name: "Рик C-137", bio: "Безумный токсичный ученый. Ненавидит глупые детективные тайны.", skill: "Техно-дедукция", color: "#00ff88" },
    { id: "patrick_jane", name: "Патрик Джейн", bio: "Гениальный менталист. Читает скрытые мотивы людей по мимике.", skill: "Чтение мыслей", color: "#ffcc00" },
    { id: "sol_goodman", name: "Сол Гудман", bio: "Эпатажный адвокат из Альбукерке. Виртуоз юридических лазеек.", skill: "Красноречие", color: "#ff9900" },
    { id: "rick_prime", name: "Рик Прайм", bio: "Главный преступник мультивселенной. Цель: скрыть улики.", skill: "Абсолютная скрытность", color: "#00ccff" },
    { id: "morty", name: "Морти", bio: "Внук Рика, паникующий подросток. Полагается на чистую удачу.", skill: "Случайная удача", color: "#ffff00" }
  ];

  export default {
    private: {
      characters: characters, viewMode: "menu", charIndex: 0, activeChar: {},
      stage: 1, stageTitle: "Акт 1: Начало", gameText: "", choice1Text: "", choice2Text: "",
      hasSarcasm: true, confidencePoints: 20, anxietyPoints: 20, isLocked: false, timerSeconds: 30,
      endingId: 1, endingText: "", cheshiyaStreak: 0, completedChars: [], ach1: false, ach2: false, ach3: false
    },

    onCreate() {
      this.activeChar = characters[this.charIndex];
      this.loadSavedProgress();
    },

    vibrateShort() {
      try { vibrator.vibrate({ mode: 'short' }); } catch(e) {}
    },

    onHeroSwipe(e) {
      this.charIndex = e.index;
      this.activeChar = characters[this.charIndex];
      this.vibrateShort(); // Механический дорогой клик при свайпе виджета [3.1]
    },

    startGame() {
      this.vibrateShort(); this.viewMode = "game"; this.stage = 1; this.confidencePoints = 20; this.anxietyPoints = 20; this.isLocked = false; this.generateStage();
    },

    generateStage() {
      const plot = DailyPlots.getStory(this.activeChar.id, this.stage);
      if (this.stage === 1) {
        this.stageTitle = this.activeChar.id === "rick_prime" ? "Акт 1: Преступление" : "Акт 1: Особняк";
        this.gameText = plot.text; this.choice1Text = plot.c1; this.choice2Text = plot.c2;
      } else if (this.stage === 2) {
        this.stageTitle = this.activeChar.id === "rick_prime" ? "Акт 2: Алиби" : "Акт 2: Давление";
        this.gameText = plot; this.anxietyPoints += this.activeChar.id === "rick_prime" ? 25 : 15;
        this.choice1Text = this.activeChar.id === "rick_prime" ? "Идеальное Алиби" : "Вынести вердикт";
        this.choice2Text = "Глубокий анализ (30 с)";
        if (this.anxietyPoints >= 100) { this.triggerAnxietyDefeat(); }
      }
    },

    makeChoice(num) {
      this.vibrateShort();
      if (this.stage === 1) { this.stage = 2; this.confidencePoints += 15; this.generateStage(); } 
      else if (this.stage === 2) { if (num === 2) { this.startAnalysisTimer(); } else { this.triggerEnding(); } }
    },makeSarcasm() {
this.vibrateShort(); this.confidencePoints += 30; this.anxietyPoints = Math.max(0, this.anxietyPoints - 20);
this.gameText = DailyPlots.getSarcasm(this.activeChar.id); this.hasSarcasm = false;
if ((this.activeChar.id === "rick_c137" || this.activeChar.id === "rick_prime") && this.confidencePoints >= 100) { this.triggerToxicityEnding(); }
},
startAnalysisTimer() {
this.isLocked = true; this.timerSeconds = 30;
let interval = setInterval(() => {
this.timerSeconds--;
if (this.timerSeconds <= 0) { clearInterval(interval); this.isLocked = false; this.confidencePoints += 20; this.triggerEnding(); }
}, 1000);
},
triggerEnding() {
this.viewMode = "ending";
if (this.activeChar.id === "cheshiya") {
if (this.confidencePoints >= 55 && this.anxietyPoints <= 25) { this.cheshiyaStreak++; } else { this.cheshiyaStreak = 0; }
}
const finalResult = DailyPlots.getEnding(this.activeChar.id, this.confidencePoints, this.anxietyPoints, this.cheshiyaStreak);
this.endingId = finalResult.id; this.endingText = finalResult.text;
if (this.endingId === 21) { this.ach1 = true; }
if (this.endingId === 22) { this.ach2 = true; }
if ([1, 2, 3, 4, 5, 6, 21].indexOf(this.endingId) !== -1) {
if (this.completedChars.indexOf(this.activeChar.id) === -1) { this.completedChars.push(this.activeChar.id); }
}
if (this.completedChars.length === 6) { this.ach3 = true; }
this.saveProgress();
},
triggerToxicityEnding() {
this.viewMode = "ending"; this.ach2 = true; this.endingId = 22;
this.endingText = "ПАСХАЛКА АЛЕКСАНДРА СОЛДАТОВА: Тотальный Солдаут! Наглость Рика достигла 100 процентов. Орбитальный лазер дезинтегрировал особняк Тромби.";
this.saveProgress();
},
triggerAnxietyDefeat() {
this.viewMode = "ending"; this.endingId = 8;
this.endingText = "ПОРАЖЕНИЕ: Логический тупик! Очки Тревожности достигли 100 процентов. Персонаж запаниковал и выдал себя.";
this.cheshiyaStreak = 0; this.saveProgress();
},
showAchievements() { this.vibrateShort(); this.viewMode = "achievements"; },
backToMenu() { this.vibrateShort(); this.viewMode = "menu"; this.hasSarcasm = true; },
// ИСПРАВЛЕННОЕ ЖЕЛЕЗОБЕТОННОЕ СОХРАНЕНИЕ С СЕРИАЛИЗАЦИЕЙ СТРОК
saveProgress() {
const data = { cheshiyaStreak: this.cheshiyaStreak, completedChars: this.completedChars, ach1: this.ach1, ach2: this.ach2, ach3: this.ach3 };
storage.set({
key: 'game_save',
value: JSON.stringify(data), // В VelaOS передается строго строка, JSON-объекты вызывали сброс!
success: () => { console.log("Прогресс успешно сохранен в память чипа."); }
});
},
onDestroy() { this.saveProgress(); },
loadSavedProgress() {
storage.get({
key: 'game_save', default: "",
success: (data) => {
if (data) {
const parsed = JSON.parse(data);
this.cheshiyaStreak = parsed.cheshiyaStreak || 0; this.completedChars = parsed.completedChars || [];
this.ach1 = parsed.ach1 || false; this.ach2 = parsed.ach2 || false; this.ach3 = parsed.ach3 || false;
}
}
});
}
}

